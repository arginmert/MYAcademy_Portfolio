@model List<MYAcademy_Portfolio.Entities.Message>
@{
    ViewData["Title"] = "Mesajlar";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    var unreadCount = Model.Count(m => !m.IsRead);
}
<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .edu-admin .card-soft {
        border: 0;
        border-radius: 1.25rem;
        box-shadow: 0 4px 24px rgba(30, 27, 75, .07);
    }

    .edu-admin .icon-box {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        background: #f4f2ff;
        color: #6d5dfc;
        display: grid;
        place-items: center;
        font-size: 1.3rem;
    }

    .edu-admin table {
        margin: 0;
    }

    .edu-admin thead th {
        background: #f8f7ff;
        color: #475069;
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        border-bottom: 1px solid #e9e7f5;
        padding: 1rem 1.25rem;
        white-space: nowrap;
    }

    .edu-admin tbody td {
        padding: 1rem 1.25rem;
        vertical-align: middle;
        border-color: #f0eef9;
    }

    .edu-admin tbody tr:last-child td {
        border-bottom: 0;
    }

    .edu-admin tr.is-unread .cell-sender,
    .edu-admin tr.is-unread .cell-subject {
        font-weight: 700;
        color: #1e1b4b;
    }

    .edu-admin .cell-email {
        color: #6b7280;
        font-size: .88rem;
    }

    .edu-admin .cell-date {
        color: #6b7280;
        font-size: .88rem;
        white-space: nowrap;
    }

    .edu-admin .badge-soft {
        display: inline-block;
        font-weight: 600;
        border-radius: 2rem;
        padding: .4rem .8rem;
        font-size: .78rem;
        white-space: nowrap;
    }

        .edu-admin .badge-soft.new {
            background: #f4f2ff;
            color: #6d5dfc;
        }

        .edu-admin .badge-soft.read {
            background: #f1f2f6;
            color: #6b7280;
        }

    .edu-admin .btn-add {
        background: #6d5dfc;
        color: #fff;
        border: 0;
        border-radius: .8rem;
        padding: .55rem 1.1rem;
        font-weight: 600;
        font-size: .9rem;
        text-decoration: none;
    }

        .edu-admin .btn-add:hover {
            background: #5a4be0;
            color: #fff;
        }

    .edu-admin .btn-act {
        border-radius: .6rem;
        width: 38px;
        height: 38px;
        display: inline-grid;
        place-items: center;
        border: 0;
        text-decoration: none;
    }

    .edu-admin .btn-view {
        background: #f4f2ff;
        color: #6d5dfc;
    }

        .edu-admin .btn-view:hover {
            background: #6d5dfc;
            color: #fff;
        }

    .edu-admin .btn-del {
        background: #fdecec;
        color: #dc3545;
    }

        .edu-admin .btn-del:hover {
            background: #dc3545;
            color: #fff;
        }

    .edu-admin .empty-state {
        padding: 3.5rem 1rem;
        text-align: center;
        color: #6b7280;
    }

    /* SweetAlert2 pencereleri */
    .msg-popup {
        border-radius: 1.25rem !important;
        padding: 1.75rem !important;
    }

        .msg-popup .swal2-title {
            font-size: 1.25rem;
            color: #1e1b4b;
            text-align: left;
            padding: 0;
        }

        .msg-popup .swal2-html-container {
            text-align: left;
            margin: 1rem 0 0;
            padding: 0;
        }

    .msg-meta {
        display: flex;
        flex-direction: column;
        gap: .4rem;
        background: #f8f7ff;
        border-radius: .9rem;
        padding: .9rem 1.1rem;
        font-size: .88rem;
        color: #475069;
    }

        .msg-meta i {
            color: #6d5dfc;
            margin-right: .5rem;
        }

        .msg-meta a {
            color: #6d5dfc;
            text-decoration: none;
        }

    .msg-body {
        margin-top: 1rem;
        font-size: .95rem;
        line-height: 1.7;
        color: #374151;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        max-height: 320px;
        overflow-y: auto;
    }

    .msg-btn {
        border-radius: .8rem !important;
        font-weight: 600 !important;
        padding: .6rem 1.4rem !important;
    }
</style>

@Html.AntiForgeryToken()

<div class="container-fluid edu-admin py-4">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-box"><i class="bi bi-envelope"></i></div>
            <div>
                <h4 class="mb-0 fw-bold">Mesajlar</h4>
                <span class="text-secondary small">İletişim formundan gelen mesajlar.</span>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge rounded-pill text-bg-light px-3 py-2">
                Toplam: @Model.Count · Okunmamış: <span id="unreadCount">@unreadCount</span>
            </span>
            <a href="/Admin/Message/CreateMessage" class="btn-add">
                <i class="bi bi-plus-lg me-1"></i>Yeni Mesaj
            </a>
        </div>
    </div>

    <div class="card card-soft overflow-hidden">
        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <div class="icon-box mx-auto mb-3"><i class="bi bi-inbox"></i></div>
                <p class="mb-0">Henüz mesaj yok.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Gönderici</th>
                            <th>Email</th>
                            <th>Konu</th>
                            <th>Tarih</th>
                            <th>Durum</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderByDescending(m => m.SendDate))
                        {
                            <tr class="@(item.IsRead ? "" : "is-unread")">
                                <td class="cell-sender">@item.NameSurname</td>
                                <td class="cell-email">@item.Email</td>
                                <td class="cell-subject">@item.Subject</td>
                                <td class="cell-date">@item.SendDate.ToString("dd MMM yyyy HH:mm")</td>
                                <td>
                                    @if (item.IsRead)
                                    {
                                        <span class="badge-soft read js-status">Okundu</span>
                                    }
                                    else
                                    {
                                        <span class="badge-soft new js-status">Yeni</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <button type="button" class="btn-act btn-view js-open" title="Mesajı Aç"
                                            data-id="@item.MessageId"
                                            data-name="@item.NameSurname"
                                            data-email="@item.Email"
                                            data-subject="@item.Subject"
                                            data-date="@item.SendDate.ToString("dd MMMM yyyy HH:mm")"
                                            data-message="@item.MessageDetail"
                                            data-read="@(item.IsRead ? "1" : "0")">
                                        <i class="bi bi-envelope-open"></i>
                                    </button>
                                    <a href="/Admin/Message/DeleteMessage/@item.MessageId"
                                       class="btn-act btn-del js-delete" title="Mesajı Sil"
                                       data-name="@item.NameSurname">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        // Bilgi satırı: ikon + metin (isteğe bağlı bağlantı)
        function metaRow(icon, text, href) {
            var row = document.createElement('div');
            var i = document.createElement('i');
            i.className = 'bi ' + icon;
            row.appendChild(i);

            if (href) {
                var a = document.createElement('a');
                a.href = href;
                a.textContent = text;
                row.appendChild(a);
            } else {
                row.appendChild(document.createTextNode(text));
            }
            return row;
        }

        // Mesajı okuma penceresi
        document.querySelectorAll('.js-open').forEach(function (button) {
            button.addEventListener('click', function () {
                var d = button.dataset;

                var content = document.createElement('div');

                var meta = document.createElement('div');
                meta.className = 'msg-meta';
                meta.appendChild(metaRow('bi-person', d.name));
                meta.appendChild(metaRow('bi-envelope', d.email, 'mailto:' + d.email));
                meta.appendChild(metaRow('bi-calendar3', d.date));

                var body = document.createElement('div');
                body.className = 'msg-body';
                body.textContent = d.message;

                content.appendChild(meta);
                content.appendChild(body);

                Swal.fire({
                    titleText: d.subject,
                    html: content,
                    width: 620,
                    showCloseButton: true,
                    confirmButtonText: 'Kapat',
                    confirmButtonColor: '#6d5dfc',
                    customClass: { popup: 'msg-popup', confirmButton: 'msg-btn' }
                });

                // İlk açılışta okundu olarak işaretle
                if (d.read === '0') {
                    fetch('/Admin/Message/MarkAsRead/' + d.id, {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': token }
                    }).then(function (response) {
                        if (!response.ok) return;

                        button.dataset.read = '1';
                        var row = button.closest('tr');
                        row.classList.remove('is-unread');

                        var status = row.querySelector('.js-status');
                        status.textContent = 'Okundu';
                        status.classList.remove('new');
                        status.classList.add('read');

                        var counter = document.getElementById('unreadCount');
                        counter.textContent = Math.max(0, parseInt(counter.textContent, 10) - 1);
                    });
                }
            });
        });

        // Silme uyarısı
        document.querySelectorAll('.js-delete').forEach(function (link) {
            link.addEventListener('click', function (e) {
                e.preventDefault();

                Swal.fire({
                    titleText: 'Mesaj silinsin mi?',
                    text: link.dataset.name + ' tarafından gönderilen mesaj kalıcı olarak silinecek.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Evet, sil',
                    cancelButtonText: 'Vazgeç',
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6b7280',
                    reverseButtons: true,
                    customClass: { popup: 'msg-popup', confirmButton: 'msg-btn', cancelButton: 'msg-btn' }
                }).then(function (result) {
                    if (result.isConfirmed) {
                        window.location.href = link.href;
                    }
                });
            });
        });
    });
</script>