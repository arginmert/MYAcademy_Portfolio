@model List<MYAcademy_Portfolio.Entities.Category>
@{
    ViewData["Title"] = "Kategoriler";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .edu-admin .card-soft {
        border: 0;
        border-radius: 1.25rem;
        box-shadow: 0 4px 24px rgba(30, 27, 75, .07);
    }

    .edu-admin .icon-box {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        background: #f4f2ff;
        color: #6d5dfc;
        display: grid;
        place-items: center;
        font-size: 1.3rem;
    }

    .edu-admin table {
        margin: 0;
    }

    .edu-admin thead th {
        background: #f8f7ff;
        color: #475069;
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        border-bottom: 1px solid #e9e7f5;
        padding: 1rem 1.25rem;
        white-space: nowrap;
    }

    .edu-admin tbody td {
        padding: 1rem 1.25rem;
        vertical-align: middle;
        border-color: #f0eef9;
    }

    .edu-admin tbody tr:last-child td {
        border-bottom: 0;
    }

    .edu-admin .badge-category {
        background: #f4f2ff;
        color: #6d5dfc;
        font-weight: 600;
        border-radius: 2rem;
        padding: .4rem .8rem;
        font-size: .78rem;
        white-space: nowrap;
    }

    .edu-admin .btn-add {
        background: #6d5dfc;
        color: #fff;
        border: 0;
        border-radius: .8rem;
        padding: .55rem 1.1rem;
        font-weight: 600;
        font-size: .9rem;
        text-decoration: none;
    }

        .edu-admin .btn-add:hover {
            background: #5a4be0;
            color: #fff;
        }

    .edu-admin .btn-act {
        border-radius: .6rem;
        width: 38px;
        height: 38px;
        display: inline-grid;
        place-items: center;
        border: 0;
        text-decoration: none;
    }

    .edu-admin .btn-edit {
        background: #e8f8ef;
        color: #1f9d55;
    }

        .edu-admin .btn-edit:hover {
            background: #1f9d55;
            color: #fff;
        }

    .edu-admin .btn-del {
        background: #fdecec;
        color: #dc3545;
    }

        .edu-admin .btn-del:hover {
            background: #dc3545;
            color: #fff;
        }

    .edu-admin .alert-soft {
        border: 0;
        border-radius: 1rem;
        padding: .9rem 1.25rem;
        font-size: .92rem;
        font-weight: 500;
    }

        .edu-admin .alert-soft.success {
            background: #e8f8ef;
            color: #1f9d55;
        }

        .edu-admin .alert-soft.error {
            background: #fdecec;
            color: #dc3545;
        }

    .edu-admin .empty-state {
        padding: 3.5rem 1rem;
        text-align: center;
        color: #6b7280;
    }
</style>

<div class="container-fluid edu-admin py-4">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-box"><i class="bi bi-bookmarks"></i></div>
            <div>
                <h4 class="mb-0 fw-bold">Kategoriler</h4>
                <span class="text-secondary small">Projelerin gruplandığı kategoriler.</span>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge rounded-pill text-bg-light px-3 py-2">Toplam: @Model.Count kayıt</span>
            <a href="/Admin/Categories/CreateCategory" class="btn-add">
                <i class="bi bi-plus-lg me-1"></i>Yeni Kategori
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-soft success mb-4">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-soft error mb-4">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        </div>
    }

    <div class="card card-soft overflow-hidden">
        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <div class="icon-box mx-auto mb-3"><i class="bi bi-bookmark-plus"></i></div>
                <p class="mb-3">Henüz kategori eklenmemiş.</p>
                <a href="/Admin/Categories/CreateCategory" class="btn-add">İlk Kategoriyi Ekle</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th style="width: 90px;">#</th>
                            <th>Kategori Adı</th>
                            <th style="width: 140px;" class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-secondary">@item.CategoryId</td>
                                <td><span class="badge-category">@item.CategoryName</span></td>
                                <td class="text-end text-nowrap">
                                    <a href="/Admin/Categories/EditCategory/@item.CategoryId"
                                       class="btn-act btn-edit" title="Düzenle">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <form action="/Admin/Categories/DeleteCategory/@item.CategoryId"
                                          method="post" class="d-inline"
                                          onsubmit="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-act btn-del" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>