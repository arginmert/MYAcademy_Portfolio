@model List<MYAcademy_Portfolio.Entities.About>

@{
    ViewData["Title"] = "Hakkında";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .edu-admin .card-soft {
        border: 0;
        border-radius: 1.25rem;
        box-shadow: 0 4px 24px rgba(30, 27, 75, .07);
    }

    .edu-admin .icon-box {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        background: #f4f2ff;
        color: #6d5dfc;
        display: grid;
        place-items: center;
        font-size: 1.3rem;
    }

    .edu-admin .card-head {
        background: #f8f7ff;
        border-bottom: 1px solid #e9e7f5;
        padding: 1rem 1.5rem;
    }

    .edu-admin .card-head-title {
        color: #475069;
        font-size: .8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .edu-admin .detail-row {
        display: flex;
        gap: 1.5rem;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #f0eef9;
    }

        .edu-admin .detail-row:last-child {
            border-bottom: 0;
        }

    .edu-admin .detail-label {
        flex: 0 0 170px;
        color: #475069;
        font-size: .8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .04em;
        padding-top: .15rem;
    }

        .edu-admin .detail-label i {
            color: #6d5dfc;
            margin-right: .5rem;
        }

    .edu-admin .detail-value {
        flex: 1;
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .edu-admin .detail-desc {
        color: #6b7280;
        font-size: .92rem;
        line-height: 1.65;
    }

    .edu-admin .badge-soft {
        display: inline-block;
        font-weight: 600;
        border-radius: 2rem;
        padding: .4rem .8rem;
        font-size: .78rem;
        white-space: nowrap;
    }

        .edu-admin .badge-soft.yes {
            background: #e8f8ef;
            color: #1f9d55;
        }

        .edu-admin .badge-soft.no {
            background: #fdecec;
            color: #dc3545;
        }

    .edu-admin .btn-add {
        background: #6d5dfc;
        color: #fff;
        border: 0;
        border-radius: .8rem;
        padding: .5rem 1.1rem;
        font-weight: 600;
        font-size: .88rem;
        text-decoration: none;
    }

        .edu-admin .btn-add:hover {
            background: #5a4be0;
            color: #fff;
        }

    .edu-admin .empty-state {
        padding: 3.5rem 1rem;
        text-align: center;
        color: #6b7280;
    }

    @@media (max-width: 576px) {
        .edu-admin .detail-row {
            flex-direction: column;
            gap: .35rem;
        }

        .edu-admin .detail-label {
            flex: none;
        }
    }
</style>

<div class="container-fluid edu-admin py-4">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-box"><i class="bi bi-person"></i></div>
            <div>
                <h4 class="mb-0 fw-bold">Hakkında Sayfası</h4>
                <span class="text-secondary small">Sitedeki "Hakkımda" bölümünde görünen bilgiler.</span>
            </div>
        </div>
        <span class="badge rounded-pill text-bg-light px-3 py-2">Toplam: @Model.Count kayıt</span>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card card-soft">
            <div class="empty-state">
                <div class="icon-box mx-auto mb-3"><i class="bi bi-person-plus"></i></div>
                <p class="mb-0">Henüz hakkında bilgisi eklenmemiş.</p>
            </div>
        </div>
    }

    @foreach (var item in Model)
    {
        <div class="card card-soft overflow-hidden mb-4">

            <div class="card-head d-flex justify-content-between align-items-center">
                <span class="card-head-title">Bilgilerin</span>
                <a href="/Admin/About/UpdateAbout/@item.AboutId" class="btn-add">
                    <i class="bi bi-pencil me-1"></i>Güncelle
                </a>
            </div>

            <div class="detail-row">
                <div class="detail-label"><i class="bi bi-person"></i>Ad Soyad</div>
                <div class="detail-value fw-semibold">@item.NameSurname</div>
            </div>
            <div class="detail-row">
                <div class="detail-label"><i class="bi bi-briefcase"></i>İş Unvanı</div>
                <div class="detail-value">@item.JobTitle</div>
            </div>
            <div class="detail-row">
                <div class="detail-label"><i class="bi bi-geo-alt"></i>Konum</div>
                <div class="detail-value">@item.Location</div>
            </div>
            <div class="detail-row">
                <div class="detail-label"><i class="bi bi-star"></i>Uzmanlık</div>
                <div class="detail-value">@item.Expert</div>
            </div>
            <div class="detail-row">
                <div class="detail-label"><i class="bi bi-envelope"></i>Email</div>
                <div class="detail-value">@item.Email</div>
            </div>
            <div class="detail-row">
                <div class="detail-label"><i class="bi bi-card-text"></i>Açıklama</div>
                <div class="detail-value detail-desc">@item.Description</div>
            </div>
            <div class="detail-row">
                <div class="detail-label"><i class="bi bi-check2-circle"></i>Çalışmaya Açık</div>
                <div class="detail-value">
                    @if (item.OpenToWork == "true")
                    {
                        <span class="badge-soft yes">Evet</span>
                    }
                    else
                    {
                        <span class="badge-soft no">Hayır</span>
                    }
                </div>
            </div>

        </div>
    }
</div>