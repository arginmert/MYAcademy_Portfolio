@model List<MYAcademy_Portfolio.Entities.Experience>

@{
    ViewData["Title"] = "Deneyim Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .edu-admin .card-soft {
        border: 0;
        border-radius: 1.25rem;
        box-shadow: 0 4px 24px rgba(30, 27, 75, .07);
    }

    .edu-admin .icon-box {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        background: #f4f2ff;
        color: #6d5dfc;
        display: grid;
        place-items: center;
        font-size: 1.3rem;
    }

    .edu-admin table {
        margin: 0;
    }

    .edu-admin thead th {
        background: #f8f7ff;
        color: #475069;
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        border-bottom: 1px solid #e9e7f5;
        padding: 1rem 1.25rem;
    }

    .edu-admin tbody td {
        padding: 1rem 1.25rem;
        vertical-align: middle;
        border-color: #f0eef9;
    }

    .edu-admin .badge-duration {
        background: #f4f2ff;
        color: #6d5dfc;
        font-weight: 600;
        border-radius: 2rem;
        padding: .4rem .8rem;
        font-size: .78rem;
        white-space: nowrap;
    }

    .edu-admin .desc-cell {
        max-width: 340px;
        color: #6b7280;
        font-size: .88rem;
    }

    .edu-admin .btn-act {
        border-radius: .6rem;
        width: 38px;
        height: 38px;
        display: inline-grid;
        place-items: center;
        border: 0;
    }

    .edu-admin .btn-edit {
        background: #e8f8ef;
        color: #1f9d55;
    }

        .edu-admin .btn-edit:hover {
            background: #1f9d55;
            color: #fff;
        }

    .edu-admin .btn-del {
        background: #fdecec;
        color: #dc3545;
    }

        .edu-admin .btn-del:hover {
            background: #dc3545;
            color: #fff;
        }
</style>

<div class="container-fluid edu-admin py-4">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-box"><i class="bi bi-briefcase"></i></div>
            <div>
                <h4 class="mb-0 fw-bold">İş Bilgileri</h4>
                <span class="text-secondary small">Sitedeki "Deneyim" bölümünde görünen kayıtlar.</span>
            </div>
        </div>
        <span class="badge rounded-pill text-bg-light px-3 py-2">Toplam: @Model.Count kayıt</span>
    </div>

    <div class="card card-soft overflow-hidden">
        <div class="table-responsive">
    <table class="table table-bordered">
        <tr>
            <th>#</th>
            <th>Başlık</th>
            <th>Alt Başlık</th>
            <th>Tarih</th>
            <th>Durum</th>
            <th>Sil</th>
            <th>Güncelle</th>
        </tr>
        @foreach (var item in Model)
        {<tr>
            <td>@item.ExperienceId</td>
            <td>@item.Title</td>
            <td>@item.SideTitle</td>
            <td>@item.Duration</td>
            <td>@item.IsActive</td>
            <td><a href="/Admin/Experience/DeleteExperience/@item.ExperienceId" class="btn btn-danger">Sil</a></td>
            <td><a href="/Admin/Experience/UpdateExperience/@item.ExperienceId" class="btn btn-success">Güncelle</a></td>
            </tr>
        }

    </table>
    <a href="/Admin/Experience/CreateExperience/" class="btn btn-primary mt-3">Yeni Deneyim Ekle</a>
</div>
</div>
</div>
