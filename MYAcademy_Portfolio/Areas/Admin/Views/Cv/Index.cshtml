@{
    ViewData["Title"] = "CV";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    bool hasCv = ViewBag.HasCv == true;
}
<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .edu-admin .card-soft {
        border: 0;
        border-radius: 1.25rem;
        box-shadow: 0 4px 24px rgba(30, 27, 75, .07);
    }

    .edu-admin .icon-box {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        background: #f4f2ff;
        color: #6d5dfc;
        display: grid;
        place-items: center;
        font-size: 1.3rem;
    }

    .edu-admin .form-label {
        color: #475069;
        font-size: .8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: .45rem;
    }

    .edu-admin .form-control {
        border: 1px solid #e9e7f5;
        border-radius: .8rem;
        padding: .7rem 1rem;
        font-size: .95rem;
    }

    .edu-admin .form-hint {
        color: #6b7280;
        font-size: .8rem;
        margin-top: .35rem;
    }

    .edu-admin .current-file {
        display: flex;
        align-items: center;
        gap: 1rem;
        background: #f8f7ff;
        border-radius: 1rem;
        padding: 1rem 1.25rem;
    }

    .edu-admin .current-file .file-meta {
        color: #6b7280;
        font-size: .85rem;
    }

    .edu-admin .btn-add {
        background: #6d5dfc;
        color: #fff;
        border: 0;
        border-radius: .8rem;
        padding: .6rem 1.4rem;
        font-weight: 600;
        font-size: .9rem;
        text-decoration: none;
    }

        .edu-admin .btn-add:hover {
            background: #5a4be0;
            color: #fff;
        }

    .edu-admin .btn-cancel {
        background: #fff;
        color: #6d5dfc;
        border: 0;
        border-radius: .8rem;
        padding: .5rem 1rem;
        font-weight: 600;
        font-size: .85rem;
        text-decoration: none;
        white-space: nowrap;
    }

    .edu-admin .alert-soft {
        border-radius: 1rem;
        padding: .9rem 1.25rem;
        font-size: .92rem;
        font-weight: 500;
    }

        .edu-admin .alert-soft.success {
            background: #e8f8ef;
            color: #1f9d55;
        }

        .edu-admin .alert-soft.error {
            background: #fdecec;
            color: #dc3545;
        }
</style>

<div class="container-fluid edu-admin py-4">

    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="icon-box"><i class="bi bi-file-earmark-person"></i></div>
        <div>
            <h4 class="mb-0 fw-bold">CV Dosyası</h4>
            <span class="text-secondary small">Sitedeki "CV İndir" butonunun indirdiği dosya.</span>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-soft success mb-4"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-soft error mb-4"><i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]</div>
    }

    <div class="card card-soft">
        <div class="card-body p-4">

            <label class="form-label">Yayındaki Dosya</label>
            @if (hasCv)
            {
                <div class="current-file mb-4">
                    <div class="icon-box"><i class="bi bi-file-earmark-pdf"></i></div>
                    <div class="flex-grow-1">
                        <div class="fw-semibold">cv.pdf</div>
                        <div class="file-meta">@ViewBag.UploadDate · @ViewBag.SizeKb KB</div>
                    </div>
                    <a href="/files/cv.pdf" target="_blank" class="btn-cancel">
                        <i class="bi bi-eye me-1"></i>Görüntüle
                    </a>
                </div>
            }
            else
            {
                <div class="current-file mb-4">
                    <div class="icon-box"><i class="bi bi-file-earmark-x"></i></div>
                    <div class="file-meta">Henüz CV yüklenmemiş. Sitedeki buton şu an gizli.</div>
                </div>
            }

            <form action="/Admin/Cv/Upload" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <label for="cvFile" class="form-label">@(hasCv ? "Yeni Dosya Yükle" : "Dosya Yükle")</label>
                <input type="file" id="cvFile" name="cvFile" class="form-control" accept=".pdf,application/pdf" required />
                <div class="form-hint">Yalnızca PDF, en fazla 5 MB. Yeni dosya eskisinin yerini alır.</div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-add">
                        <i class="bi bi-upload me-1"></i>Yükle
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>