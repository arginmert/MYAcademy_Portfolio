@model MYAcademy_Portfolio.Entities.Setting
@{
    ViewData["Title"] = "Site Ayarlarını Düzenle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    var errors = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).ToList();
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .edu-admin .card-soft {
        border: 0;
        border-radius: 1.25rem;
        box-shadow: 0 4px 24px rgba(30, 27, 75, .07);
        background: #fff;
    }

    .edu-admin .icon-box {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        background: #f4f2ff;
        color: #6d5dfc;
        display: grid;
        place-items: center;
        font-size: 1.3rem;
        flex-shrink: 0;
    }

    .edu-admin .form-label {
        color: #475069;
        font-size: .8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: 0;
    }

    .edu-admin .form-control {
        border: 1px solid #e9e7f5;
        border-radius: .8rem;
        padding: .7rem 1rem;
        font-size: .95rem;
    }

        .edu-admin .form-control:focus {
            border-color: #6d5dfc;
            box-shadow: 0 0 0 .2rem rgba(109, 93, 252, .12);
        }

    .edu-admin .counter {
        color: #9ca3af;
        font-size: .78rem;
    }

        .edu-admin .counter.warn {
            color: #d97706;
            font-weight: 600;
        }

    .edu-admin .form-hint {
        color: #6b7280;
        font-size: .8rem;
        margin-top: .35rem;
    }

    .edu-admin .google-preview {
        background: #f8f7ff;
        border-radius: 1rem;
        padding: 1.1rem 1.25rem;
    }

        .edu-admin .google-preview .g-url {
            color: #4d5156;
            font-size: .8rem;
        }

        .edu-admin .google-preview .g-title {
            color: #1a0dab;
            font-size: 1.15rem;
            margin: .2rem 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .edu-admin .google-preview .g-desc {
            color: #4d5156;
            font-size: .88rem;
            line-height: 1.5;
        }

    .edu-admin .btn-add {
        background: #6d5dfc;
        color: #fff;
        border: 0;
        border-radius: .8rem;
        padding: .6rem 1.4rem;
        font-weight: 600;
        font-size: .9rem;
    }

        .edu-admin .btn-add:hover {
            background: #5a4be0;
            color: #fff;
        }

    .edu-admin .btn-cancel {
        background: #f4f2ff;
        color: #475069;
        border: 0;
        border-radius: .8rem;
        padding: .6rem 1.4rem;
        font-weight: 600;
        font-size: .9rem;
        text-decoration: none;
    }

        .edu-admin .btn-cancel:hover {
            background: #e9e7f5;
            color: #475069;
        }

    .edu-admin .form-footer {
        border-top: 1px solid #f0eef9;
        padding-top: 1.25rem;
        margin-top: 1.5rem;
    }

    .edu-admin .alert-soft {
        border-radius: 1rem;
        padding: .9rem 1.25rem;
        font-size: .92rem;
        background: #fdecec;
        color: #dc3545;
    }
</style>

<div class="container-fluid edu-admin py-4">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-box"><i class="bi bi-sliders"></i></div>
            <div>
                <h4 class="mb-0 fw-bold">Site Ayarlarını Düzenle</h4>
                <span class="text-secondary small">Değişiklikler kaydedildiği anda sitede görünür.</span>
            </div>
        </div>
        <a href="/Admin/Settings/Index" class="btn-cancel"><i class="bi bi-arrow-left me-1"></i>Geri Dön</a>
    </div>

    @if (errors.Any())
    {
        <div class="alert-soft mb-4">
            <ul class="mb-0 ps-3">
                @foreach (var e in errors)
                {
                    <li>@e</li>
                }
            </ul>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card-soft">
                <div class="card-body p-4">
                    <form action="/Admin/Settings/UpdateSettings" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-end mb-2">
                                <label for="SiteTitle" class="form-label">Site Başlığı</label>
                                <span class="counter" id="titleCounter"></span>
                            </div>
                            <input type="text" id="SiteTitle" name="SiteTitle" class="form-control"
                                   value="@Model.SiteTitle" maxlength="70" required autofocus
                                   placeholder="Örn. Mert | .NET Developer Portfolyosu" />
                            <div class="form-hint">Tarayıcı sekmesinde ve arama sonucunun başlığında görünür.</div>
                        </div>

                        <div>
                            <div class="d-flex justify-content-between align-items-end mb-2">
                                <label for="SiteDescription" class="form-label">Site Açıklaması</label>
                                <span class="counter" id="descCounter"></span>
                            </div>
                            <textarea id="SiteDescription" name="SiteDescription" class="form-control"
                                      rows="4" maxlength="160" required
                                      placeholder="Sitenizi 1-2 cümleyle anlatın">@Model.SiteDescription</textarea>
                            <div class="form-hint">Arama sonuçlarında başlığın altında görünür.</div>
                        </div>

                        <div class="form-footer d-flex justify-content-end gap-2">
                            <a href="/Admin/Settings/Index" class="btn-cancel">Vazgeç</a>
                            <button type="submit" class="btn btn-add"><i class="bi bi-check-lg me-1"></i>Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card-soft">
                <div class="card-body p-4">
                    <div class="form-label mb-3">Canlı Önizleme</div>
                    <div class="google-preview">
                        <div class="g-url">@Context.Request.Host</div>
                        <div class="g-title" id="previewTitle"></div>
                        <div class="g-desc" id="previewDesc"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        function bind(inputId, counterId, previewId, max, fallback) {
            var input = document.getElementById(inputId);
            var counter = document.getElementById(counterId);
            var preview = document.getElementById(previewId);

            function update() {
                var len = input.value.length;
                counter.textContent = len + ' / ' + max;
                counter.classList.toggle('warn', len > max * 0.9);
                preview.textContent = input.value || fallback;
            }

            input.addEventListener('input', update);
            update();
        }

        bind('SiteTitle', 'titleCounter', 'previewTitle', 70, 'Site başlığı');
        bind('SiteDescription', 'descCounter', 'previewDesc', 160, 'Site açıklaması burada görünecek.');
    });
</script>