@model MYAcademy_Portfolio.Entities.Setting
@{
    ViewData["Title"] = "Site Ayarları";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .edu-admin .card-soft {
        border: 0;
        border-radius: 1.25rem;
        box-shadow: 0 4px 24px rgba(30, 27, 75, .07);
        background: #fff;
    }

    .edu-admin .icon-box {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        background: #f4f2ff;
        color: #6d5dfc;
        display: grid;
        place-items: center;
        font-size: 1.3rem;
        flex-shrink: 0;
    }

    .edu-admin .card-head {
        background: #f8f7ff;
        border-bottom: 1px solid #e9e7f5;
        padding: 1rem 1.5rem;
    }

    .edu-admin .card-head-title {
        color: #475069;
        font-size: .8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .edu-admin .detail-row {
        display: flex;
        gap: 1.5rem;
        padding: 1.1rem 1.5rem;
        border-bottom: 1px solid #f0eef9;
    }

        .edu-admin .detail-row:last-child {
            border-bottom: 0;
        }

    .edu-admin .detail-label {
        flex: 0 0 170px;
        color: #475069;
        font-size: .8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .04em;
        padding-top: .15rem;
    }

        .edu-admin .detail-label i {
            color: #6d5dfc;
            margin-right: .5rem;
        }

    .edu-admin .detail-value {
        flex: 1;
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .edu-admin .char-info {
        color: #9ca3af;
        font-size: .78rem;
        margin-top: .25rem;
    }

    .edu-admin .google-preview {
        background: #f8f7ff;
        border-radius: 1rem;
        padding: 1.1rem 1.25rem;
    }

        .edu-admin .google-preview .g-url {
            color: #4d5156;
            font-size: .8rem;
        }

        .edu-admin .google-preview .g-title {
            color: #1a0dab;
            font-size: 1.15rem;
            margin: .2rem 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .edu-admin .google-preview .g-desc {
            color: #4d5156;
            font-size: .88rem;
            line-height: 1.5;
        }

    .edu-admin .btn-add {
        background: #6d5dfc;
        color: #fff;
        border: 0;
        border-radius: .8rem;
        padding: .5rem 1.1rem;
        font-weight: 600;
        font-size: .88rem;
        text-decoration: none;
    }

        .edu-admin .btn-add:hover {
            background: #5a4be0;
            color: #fff;
        }

    .edu-admin .alert-soft {
        border-radius: 1rem;
        padding: .9rem 1.25rem;
        font-size: .92rem;
        font-weight: 500;
        background: #e8f8ef;
        color: #1f9d55;
    }

    .edu-admin .empty-state {
        padding: 3.5rem 1rem;
        text-align: center;
        color: #6b7280;
    }

    @@media (max-width: 576px) {
        .edu-admin .detail-row {
            flex-direction: column;
            gap: .35rem;
        }

        .edu-admin .detail-label {
            flex: none;
        }
    }
</style>

<div class="container-fluid edu-admin py-4">

    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="icon-box"><i class="bi bi-gear"></i></div>
        <div>
            <h4 class="mb-0 fw-bold">Site Ayarları</h4>
            <span class="text-secondary small">Tarayıcı sekmesinde ve arama motorlarında görünen bilgiler.</span>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-soft mb-4"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]</div>
    }

    @if (Model == null)
    {
        <div class="card-soft">
            <div class="empty-state">
                <div class="icon-box mx-auto mb-3"><i class="bi bi-sliders"></i></div>
                <p class="mb-3">Henüz site ayarı girilmemiş.</p>
                <a href="/Admin/Settings/UpdateSettings" class="btn-add">Ayarları Oluştur</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card-soft overflow-hidden h-100">
                    <div class="card-head d-flex justify-content-between align-items-center">
                        <span class="card-head-title">Genel Bilgiler</span>
                        <a href="/Admin/Settings/UpdateSettings" class="btn-add">
                            <i class="bi bi-pencil me-1"></i>Düzenle
                        </a>
                    </div>
                    <div class="detail-row">
                        <div class="detail-label"><i class="bi bi-type"></i>Site Başlığı</div>
                        <div class="detail-value">
                            <div class="fw-semibold">@Model.SiteTitle</div>
                            <div class="char-info">@Model.SiteTitle.Length / 70 karakter</div>
                        </div>
                    </div>
                    <div class="detail-row">
                        <div class="detail-label"><i class="bi bi-card-text"></i>Site Açıklaması</div>
                        <div class="detail-value">
                            <div>@Model.SiteDescription</div>
                            <div class="char-info">@Model.SiteDescription.Length / 160 karakter</div>
                        </div>
                    </div>
                    <div class="detail-row">
                        <div class="detail-label"><i class="bi bi-clock-history"></i>Son Güncelleme</div>
                        <div class="detail-value text-secondary">@Model.UpdatedDate.ToString("dd MMMM yyyy HH:mm")</div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card-soft overflow-hidden h-100">
                    <div class="card-head"><span class="card-head-title">Arama Sonucu Önizlemesi</span></div>
                    <div class="p-4">
                        <div class="google-preview">
                            <div class="g-url">@Context.Request.Host</div>
                            <div class="g-title">@Model.SiteTitle</div>
                            <div class="g-desc">@Model.SiteDescription</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>