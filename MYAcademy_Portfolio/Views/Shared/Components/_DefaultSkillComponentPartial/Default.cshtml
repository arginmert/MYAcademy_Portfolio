@model List<MYAcademy_Portfolio.Entities.Skill>

@{
    // Satırları kategori başlığına göre grupla; kartlar ilk eklenme sırasına göre dizilir
    var groups = Model
        .OrderBy(s => s.SkillId)
        .GroupBy(s => s.SkillCategoryTitle)
        .ToList();
}

<style>
    .skill-progress {
        height: 8px;
        border-radius: 1rem;
        background: #eceaf9;
        overflow: hidden;
    }

        .skill-progress .progress-bar {
            display: block;
            height: 100%;
            border-radius: 1rem;
            background: linear-gradient(90deg, #8b7dff, #6d5dfc);
            animation: fillBar 1.2s ease-out both;
        }

    @@keyframes fillBar {
        from {
            width: 0;
        }
    }

    }
</style>

<section id="skills" style="background-color: var(--bg-secondary);">
    <div class="container">
        <div class="text-center mb-5 reveal-on-scroll">
            <span class="section-eyebrow">TEKNİK YETKİNLİKLER</span>
            <h2 class="section-title">Yeteneklerim</h2>
            <p class="section-subtitle">Fikirleri çalışan yazılımlara dönüştürürken kullandığım teknolojiler.</p>
        </div>

        <div class="row g-4">
            @for (int i = 0; i < groups.Count; i++)
            {
                var group = groups[i];
                var first = group.First();
                var col = i < 3 ? "col-lg-4 col-md-6" : "col-lg-6 col-md-6";

                <div class="@col reveal-on-scroll">
                    <div class="skill-group-card">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="float-icon-box @first.SkillCategoryColor">
                                <i class="bi @first.SkillCategoryIcon"></i>
                            </div>
                            <h4 class="fs-5 fw-bold mb-0">@group.Key</h4>
                        </div>
                        <p class="text-secondary small mb-3">@first.SkillCategoryDescription</p>

                        @foreach (var skill in group)
                        {
                            <div class="mb-3">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="fw-semibold">@skill.Name</span>
                                    <span class="text-secondary">%@skill.Level</span>
                                </div>
                                <div class="skill-progress">
                                    <div class="progress-bar" role="progressbar"
                                         style="width: @(skill.Level)%"
                                         aria-valuenow="@skill.Level" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>